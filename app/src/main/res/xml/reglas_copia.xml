<?xml version="1.0" encoding="utf-8"?>
<!--
  Qué entra en la copia de seguridad del sistema (Android 12+).

  Se incluyen las preferencias (equipos, ajustes, marca del solitario) y nada
  mas. El respaldo previo a una importacion no hace falta excluirlo: vive en la
  raiz de filesDir y del dominio de ficheros solo entra `datastore`, asi que ya
  se queda fuera. Declararlo aparte era redundante y lint lo senalaba.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
